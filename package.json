{
	"name": "obsidian-live-files-plugin",
	"version": "1.0.0",
	"description": "Obsidian plugin: Tail Follow (keep a note scrolled to its end while it grows) and highlighting of files changed outside Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test src/*.test.ts",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test:e2e": "npm run build && node tests/e2e/run.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"tail",
		"follow",
		"log",
		"live"
	],
	"author": "Dean Hallman",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.0.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.25.0",
		"obsidian": "latest",
		"tslib": "^2.6.0",
		"typescript": "^5.6.0",
		"playwright-core": "^1.59.0"
	},
	"engines": {
		"node": ">=23.6"
	}
}
